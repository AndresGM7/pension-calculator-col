# =============================================================================
# Pension Calculator - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.

# Application
APP_NAME=pension-calculator
APP_ENV=development  # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-32-char-string-min

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pension_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-32-char-string-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Stripe (payments)
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_SINGLE=price_replace_me_single
STRIPE_PRICE_HR_PACKAGE=price_replace_me_hr
STRIPE_PRICE_API_MONTHLY=price_replace_me_api

# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
